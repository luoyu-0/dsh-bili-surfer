{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": ".",
    "strict": true,
    "noUnusedLocals": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [],
    "declaration": false,
    "sourceMap": false,
    "newLine": "lf",
    "pretty": true
  },
  "files": ["src/client.ts"]
}
